<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) backup/transfer rules. The Keystore-encrypted session cookie can't be decrypted on a
     different device, so keep it out of both cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/pulse_auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/pulse_auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
